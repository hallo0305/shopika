<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="background">#171413</color>
    <color name="badge_bg">#43231B</color>
    <color name="black">#000000</color>
    <color name="border">#3B3430</color>
    <color name="card_background">#24201E</color>
    <color name="chip_bg">#312B28</color>
    <color name="divider">#332D2A</color>
    <color name="error">#E05656</color>
    <color name="error_container">#3D1616</color>
    <color name="primary">#FF7E60</color>
    <color name="primary_container">#381D17</color>
    <color name="primary_dark">#E65336</color>
    <color name="primary_light">#52291E</color>
    <color name="rating_star">#FFB81E</color>
    <color name="success">#34C085</color>
    <color name="success_container">#123625</color>
    <color name="surface">#221E1C</color>
    <color name="text_hint">#776E69</color>
    <color name="text_on_primary">#FFFFFF</color>
    <color name="text_primary">#F8EFEA</color>
    <color name="text_secondary">#ABA29D</color>
    <color name="transparent">#00000000</color>
    <color name="warning">#FFAE26</color>
    <color name="warning_container">#3A2B0E</color>
    <color name="white">#FFFFFF</color>
    <style name="ShopikaButton" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <style name="ShopikaButton.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="strokeColor">@color/primary</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <style name="ShopikaCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/border</item>
        <item name="cardBackgroundColor">@color/card_background</item>
    </style>
    <style name="Theme.Shopika" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/primary</item>

        <item name="colorSecondary">@color/primary</item>
        <item name="colorSecondaryVariant">@color/primary_dark</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightNavigationBar">false</item>

        <item name="android:windowBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
    </style>
    <style name="Theme.Shopika.Splash" parent="Theme.Shopika">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>