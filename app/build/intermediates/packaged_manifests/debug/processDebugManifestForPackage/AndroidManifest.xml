<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.shopika.app"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="36" />

    <!-- Internet & Network Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <permission
        android:name="com.shopika.app.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.shopika.app.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_shopika_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_shopika_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.Shopika"
        android:usesCleartextTraffic="true" >

        <!-- 1. Splash Screen Launcher -->
        <activity
            android:name="com.shopika.app.ui.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Shopika.Splash" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. Main Dashboard Activity (Hosts Beranda, Kategori, Keranjang, Favorit, Profil) -->
        <activity
            android:name="com.shopika.app.ui.main.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustPan" />

        <!-- 3. Daftar Produk Activity -->
        <activity
            android:name="com.shopika.app.ui.product.ProductListActivity"
            android:exported="false" />

        <!-- 4. Detail Produk Activity -->
        <activity
            android:name="com.shopika.app.ui.product.ProductDetailActivity"
            android:exported="false" />

        <!-- 5. Pencarian Activity -->
        <activity
            android:name="com.shopika.app.ui.search.SearchActivity"
            android:exported="false"
            android:windowSoftInputMode="stateVisible|adjustResize" />

        <!-- 6. Keranjang Activity -->
        <activity
            android:name="com.shopika.app.ui.cart.CartActivity"
            android:exported="false" />

        <!-- 7. Checkout Activity -->
        <activity
            android:name="com.shopika.app.ui.checkout.CheckoutActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 8. Simulasi Pembayaran Activity -->
        <activity
            android:name="com.shopika.app.ui.payment.PaymentActivity"
            android:exported="false" />

        <!-- 9. Status Pesanan Activity -->
        <activity
            android:name="com.shopika.app.ui.order.OrderStatusActivity"
            android:exported="false" />

        <!-- 10. Riwayat Pesanan Activity -->
        <activity
            android:name="com.shopika.app.ui.order.OrderHistoryActivity"
            android:exported="false" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.shopika.app.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <service
            android:name="androidx.room.MultiInstanceInvalidationService"
            android:directBootAware="true"
            android:exported="false" />

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>